# --- PostgreSQL ---
POSTGRES_USER=booking_admin
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_DB=booking_saas
POSTGRES_PORT=5432

# Runtime connection, used by the API and by prisma/seed.ts. booking_app is
# not a superuser and owns no tables, so RLS policies apply to it. The role
# is created in docker/postgres/init.sql.
DATABASE_URL=postgresql://booking_app:change_me_local_only_app@postgres:5432/booking_saas?schema=public

# Admin connection, ONLY for `prisma migrate` and admin scripts. booking_admin
# is a superuser and bypasses RLS, so runtime code must never use it.
# Override DATABASE_URL just for the migration command, e.g.:
#   docker exec -e DATABASE_URL="$DATABASE_MIGRATE_URL" booking-api npx prisma migrate deploy
DATABASE_MIGRATE_URL=postgresql://booking_admin:change_me_local_only@postgres:5432/booking_saas?schema=public

# --- Redis ---
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# --- API (NestJS) ---
API_PORT=3001
JWT_SECRET=change_me_dev_secret
JWT_REFRESH_SECRET=change_me_dev_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
NODE_ENV=development

# --- Seed (development only) ---
SEED_SUPER_ADMIN_EMAIL=admin@bookingsaas.dev
SEED_SUPER_ADMIN_PASSWORD=ChangeMe123!

# --- Web (Next.js) ---
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3001

# --- Hosted demo (Vercel + Render) ---
# Comma-separated browser origins allowed to call the API (e.g. your
# Vercel URL). Leave unset locally to allow all origins.
# CORS_ORIGIN=https://booking-saas.vercel.app
# Number of reverse proxies in front of the API (whole number, never "true").
# Without it the rate limiter sees the load balancer's IP for every user.
# Leave unset locally. See docs/deploy-demo.md.
# TRUST_PROXY=1
# Where rate-limit counters live: "memory" (default, per process) or "redis"
# (shared by every API instance; set it when running more than one).
# THROTTLE_STORAGE=redis

# --- AI assist ---
# Optional. Without a key, POST /ai/assist responds 503 (see docs/ai-assist.md).
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# Per-call timeout in milliseconds (default 20000). The call is not retried.
# OPENAI_TIMEOUT_MS=20000
