# --- PostgreSQL ---
POSTGRES_USER=booking_admin
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_DB=booking_saas
POSTGRES_PORT=5432

# Cadena de runtime — usada por PrismaService (API) y por prisma/seed.ts por
# defecto. Apunta a booking_app: NO es superuser, no es dueño de ninguna
# tabla, y por lo tanto SÍ queda sujeto a las políticas RLS. Ver
# docker/postgres/init.sql para la creación del rol.
DATABASE_URL=postgresql://booking_app:change_me_local_only_app@postgres:5432/booking_saas?schema=public

# Cadena de administración — SOLO para `prisma migrate` y scripts
# administrativos que necesiten privilegios de owner (crear/alterar tablas).
# booking_admin es SUPERUSER (creado así por la imagen oficial de postgres),
# así que ignora RLS incondicionalmente — nunca se usa para las queries de
# runtime de la aplicación. Uso: sobreescribir DATABASE_URL solo para el
# comando de migración puntual, ej.:
#   docker exec -e DATABASE_URL="$DATABASE_MIGRATE_URL" booking-api npx prisma migrate deploy
DATABASE_MIGRATE_URL=postgresql://booking_admin:change_me_local_only@postgres:5432/booking_saas?schema=public

# --- Redis ---
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# --- API (NestJS) ---
API_PORT=3001
JWT_SECRET=change_me_dev_secret
JWT_REFRESH_SECRET=change_me_dev_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
NODE_ENV=development

# --- Seed (solo desarrollo) ---
SEED_SUPER_ADMIN_EMAIL=admin@bookingsaas.dev
SEED_SUPER_ADMIN_PASSWORD=ChangeMe123!

# --- Web (Next.js) ---
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3001

# --- Demo deploy (Track 11-B: Vercel + Render) ---
# Comma-separated browser origins allowed to call the API (e.g. your
# Vercel URL). Leave unset locally to allow all origins.
# CORS_ORIGIN=https://booking-saas.vercel.app
